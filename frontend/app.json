{
  "expo": {
    "name": "catchup-app",
    "slug": "catchup-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "catchup",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "다가오는 일정을 알려드리기 위해 알림 권한이 필요합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 추가하기 위해 마이크 권한이 필요합니다."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.catchupapp",
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#14B8A6"
        }
      ],
      "expo-web-browser",
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63b4ad4b-7c4c-49c6-ba51-39581f09d0b9"
      }
    },
    "owner": "hojunlee95",
    "updates": {
      "url": "https://u.expo.dev/63b4ad4b-7c4c-49c6-ba51-39581f09d0b9"
    }
  }
}
