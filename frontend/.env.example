# API URL
# - iPhone 실기기: localhost 대신 PC LAN IP 필요 (앱이 Metro IP로 자동 설정)
# - tunnel 모드(npm run start:tunnel) 사용 시 직접 PC IP 지정:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api
EXPO_PUBLIC_USE_WATERMELON=false

# Social OAuth client ids (leave blank to use dev mock login)
# Kakao REST API key (also used as OAuth client_id)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# Naver application client id
EXPO_PUBLIC_NAVER_CLIENT_ID=
