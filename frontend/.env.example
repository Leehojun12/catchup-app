# API URL — 반드시 frontend/.env 파일에 설정 (Expo는 .env.example을 읽지 않음)
#
# Render 백엔드 (staging)
EXPO_PUBLIC_API_URL=https://catchup-app-prp8.onrender.com/api

EXPO_PUBLIC_USE_WATERMELON=false

# Social OAuth client ids (leave blank to use dev mock login)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
