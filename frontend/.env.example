# API URL — 반드시 frontend/.env 파일에 설정 (Expo는 .env.example을 읽지 않음)
#
# Render 백엔드 (staging)
EXPO_PUBLIC_API_URL=https://catchup-app-prp8.onrender.com/api

EXPO_PUBLIC_USE_WATERMELON=false

# Kakao 로그인 (REST API 키)
# Redirect URI 등록 (카카오 콘솔 → REST API 키):
#   https://catchup-app-prp8.onrender.com/api/auth/kakao/callback
EXPO_PUBLIC_KAKAO_REST_API_KEY="3650fa1b4dfcd80f16c7a896bdf3341a"
EXPO_PUBLIC_NAVER_CLIENT_ID=
