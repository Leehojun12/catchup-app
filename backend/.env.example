PORT=3000
NODE_ENV=development
JWT_SECRET=catchup-dev-secret-change-in-production

# AI / content
OPENAI_API_KEY=
YOUTUBE_API_KEY=

# Kakao (REST API key = OAuth client_id; secret optional, message scope for reminders)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Naver login (client_secret required for token exchange)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# SMS (mock | coolsms | twilio | nhn ...)
SMS_PROVIDER=mock
SMS_SENDER_NUMBER=

# Reminder scheduler tick interval (ms)
REMINDER_TICK_MS=60000
